# Copie para .env e preencha. Nunca versione o .env.

# Frontend (públicas: protegidas por RLS, não são segredo)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Scripts locais (SEGREDO: só na sua máquina / CI, nunca no frontend)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# TMDB (DEC-041): "API Read Access Token" da sua conta em themoviedb.org/settings/api. Só para npm run tmdb:enrich.
TMDB_READ_TOKEN=

# Edge Functions: configure com `supabase secrets set` (produção) ou supabase/functions/.env (local)
# CRON_SECRET=          # mesmo valor guardado no Vault como 'cron_secret'
# ALLOWED_ORIGIN=       # ex.: https://cineou.vercel.app
